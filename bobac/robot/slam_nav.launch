<!--
  SLAM + navigation in ONE launch file, for the bobac3 (runs ON THE ROBOT, ROS Noetic).

    roslaunch ~/leuk/bobac/robot/slam_nav.launch                    # mode:=slam (default)
    roslaunch ~/leuk/bobac/robot/slam_nav.launch mode:=nav map:=demo

  Needs the robot env (REI_ROBOT, LASER_TYPE, MAP_DIRECTORY): use `ssh -t` and type the command,
  or `bash -ic "roslaunch ..."`. Built only from vendor packages (read-only copy in bobac/vendor/).
  Safety: someone at the e-stop; only one thing publishes /cmd_vel at a time.
-->
<launch>
  <arg name="mode" default="slam" doc="slam: build the map while navigating; nav: saved map + amcl"/>
  <arg name="map" default="demo" doc="nav mode: map name in map_directory (without .yaml)"/>
  <arg name="map_directory" default="$(env MAP_DIRECTORY)"/>
  <arg name="max_vel" default="0.3" doc="m/s, forward, backward and sideways (team limit: 0.4)"/>
  <arg name="max_vel_theta" default="0.8" doc="rad/s (team limit: 0.8)"/>
  <arg name="nav_params" value="$(find bobac3_navigation)/param"/>
  <arg name="rviz" default="true" doc="needs the robot screen, or DISPLAY=:0 from SSH"/>
  <arg name="joy" default="true" doc="joystick teleop (it only publishes while enabled on the pad)"/>
  <arg name="slam" value="$(eval arg('mode') == 'slam')"/>

  <!-- robot model (tf of the base, lidars and cameras) -->
  <include file="$(find bobac3_description)/launch/display.launch">
    <arg name="open_rviz" value="false"/>
  </include>

  <!-- base (same node name as the one started at boot, so this one replaces it) -->
  <include file="$(find rei_robot_base)/launch/base.launch"/>

  <!-- front + rear lidar, merged into /fuse_scan -->
  <include file="$(find cspc_lidar)/launch/bobac3_lidar.launch"/>

  <include if="$(arg joy)" file="$(find robot_joy)/launch/robot_joy.launch"/>

  <!-- slam: gmapping builds /map from /fuse_scan and publishes map -> odom.
       Save the map when it looks good (another terminal, keeps this launch running):
         roslaunch map_manager map_save.launch map_file:=demo -->
  <group if="$(arg slam)">
    <include file="$(find bobac3_slam)/launch/bobac3_gmapping.launch"/>
  </group>

  <!-- nav: saved map + amcl localisation + the map's virtual walls (no-go lines).
       Set the start pose with "2D Pose Estimate" in rviz if the robot is not at the map origin. -->
  <group unless="$(arg slam)">
    <include file="$(find map_manager)/launch/map_load.launch">
      <arg name="map_file" value="$(arg map)"/>
      <arg name="map_directory" value="$(arg map_directory)"/>
    </include>
    <include file="$(find bobac3_navigation)/launch/amcl.launch"/>
    <node name="virtual_wall_map_publisher" pkg="ros_map_edit" type="virtual_wall_map_publisher.py">
      <param name="map_file" value="$(arg map_directory)/$(arg map).yaml"/>
    </node>
  </group>

  <!-- move_base: vendor params (TEB local planner, navfn), same node name as the vendor
       move_base.launch. Goals: action /move_base or "2D Nav Goal" in rviz. -->
  <node pkg="move_base" type="move_base" name="move_base_node" respawn="false" output="screen">
    <rosparam file="$(arg nav_params)/costmap_common_params_global.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(arg nav_params)/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(arg nav_params)/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(arg nav_params)/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(arg nav_params)/teb_local_planner_params.yaml" command="load"/>
    <rosparam file="$(arg nav_params)/move_base_params.yaml" command="load"/>
    <rosparam file="$(arg nav_params)/navfn_global_planner_params.yaml" command="load"/>

    <!-- Team speed limits (vendor: 0.5 m/s, 1.0 rad/s). -->
    <param name="TebLocalPlannerROS/max_vel_x" value="$(arg max_vel)"/>
    <param name="TebLocalPlannerROS/max_vel_x_backwards" value="$(arg max_vel)"/>
    <param name="TebLocalPlannerROS/max_vel_y" value="$(arg max_vel)"/>
    <param name="TebLocalPlannerROS/max_vel_theta" value="$(arg max_vel_theta)"/>

    <!-- slam mode has no virtual walls: the vendor virtual_wall_layer would block move_base
         forever waiting for /virtual_wall_map, so load the costmaps without it. -->
    <rosparam if="$(arg slam)" param="global_costmap/plugins">
      - {name: static_layer, type: "costmap_2d::StaticLayer"}
      - {name: obstacle_layer, type: "costmap_2d::VoxelLayer"}
      - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    </rosparam>
    <rosparam if="$(arg slam)" param="local_costmap/plugins">
      - {name: obstacle_layer, type: "costmap_2d::VoxelLayer"}
      - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    </rosparam>
  </node>

  <!-- map, scans, costmaps and plans; "2D Nav Goal" sends the robot somewhere -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find bobac3_navigation)/rviz/robot_navigation.rviz"/>
</launch>
