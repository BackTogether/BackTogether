<?xml version="1.0"?>
<package format="2">
  <name>bringup</name>
  <version>0.0.1</version>
  <description>One launch file that starts every block of the demo</description>
  <maintainer email="noreply@example.com">leukerbad team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- launched by slam_nav.launch / bringup.launch (vendor packages, built in ~/bobac3_ws) -->
  <exec_depend>bobac3_description</exec_depend>
  <exec_depend>rei_robot_base</exec_depend>
  <exec_depend>cspc_lidar</exec_depend>
  <exec_depend>bobac3_slam</exec_depend>
  <exec_depend>bobac3_navigation</exec_depend>
  <exec_depend>robot_joy</exec_depend>
  <exec_depend>face_rec</exec_depend>
  <exec_depend>ar_pose</exec_depend>
  <!-- standard ROS -->
  <exec_depend>move_base</exec_depend>
  <exec_depend>rviz</exec_depend>
  <!-- the scripts -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- splash.py: full screen image -->
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-pil</exec_depend>

</package>
