<launch>
  <!-- home: waiting for a goal sent by hand -> arrived -> searching -> care.
       The goal is manual: rviz (open_rviz:=true splash:=false) or /move_base_simple/goal.
       In care the kid_care package takes over: the voice agent talks with the child and the
       video call with the parents opens on the robot's screen. -->

  <arg name="person" default="jorge"/>
  <arg name="face_directory" default="$(optenv FACE_DIRECTORY /home/bobac3/.reinovo/face_data)"/>
  <arg name="splash" default="true"/>
  <arg name="open_rviz" default="false"/>
  <!-- false: stop at care, without the voice agent and the video call -->
  <arg name="care" default="true"/>
  <!-- where the child is, told to the parents -->
  <arg name="zone" default="park"/>

  <node if="$(arg splash)" name="splash" pkg="bringup" type="splash.py" output="screen">
    <param name="images" value="$(find bringup)/assets"/>
    <param name="fit" value="contain"/>
    <param name="delay" value="5.0"/>
    <param name="topmost" value="true"/>
  </node>

  <node name="system_state" pkg="bringup" type="system_state.py" output="screen">
    <param name="initial_state" value="home"/>
  </node>

  <include file="$(find bringup)/launch/slam_nav.launch">
    <arg name="open_rviz" value="$(arg open_rviz)"/>
  </include>

  <node name="arrival_watch" pkg="bringup" type="arrival_watch.py" output="screen"/>

  <include file="$(find face_rec)/launch/face_rec_topic.launch">
    <arg name="face_rec_directory" value="$(arg face_directory)"/>
  </include>

  <node name="face_check" pkg="bringup" type="face_check.py" output="screen">
    <param name="person" value="$(arg person)"/>
    <param name="turn_speed" value="0.3"/>
  </node>

  <!-- care: with the child. The care server comes up now and waits; kid_care_start begins the
       episode when face_check puts the machine in care. -->
  <include if="$(arg care)" file="$(find kid_care)/launch/kid_care.launch">
    <arg name="start_state" value="care"/>
    <arg name="zone" value="$(arg zone)"/>
    <arg name="hide_splash" value="$(arg splash)"/>
  </include>
</launch>
