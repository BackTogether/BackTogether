<launch>
  <!-- Starts every block of the demo. Add one include / node per new block.

       Run it with:  roslaunch bringup bringup.launch
       The chassis driver is started here too: kill the boot-time instance
       first (rosnode kill /rei_base). -->

  <arg name="open_rviz" default="true"/>
  <!-- person to find on arrival: folder name of their photos in $FACE_DIRECTORY -->
  <arg name="person" default="jorge"/>
  <!-- true: start turning right away, without waiting for a navigation goal (to test it) -->
  <arg name="search_on_start" default="false"/>

  <!-- Block: SLAM + navigation (base, lidars, gmapping, move_base) -->
  <include file="$(find bringup)/launch/slam_nav.launch">
    <arg name="open_rviz" value="$(arg open_rviz)"/>
  </include>

  <!-- Block: head camera + face recognition -> /face_results -->
  <include file="$(find face_rec)/launch/face_rec_topic.launch"/>

  <!-- Block: on arrival at a goal, turn on the spot until the person is recognised, then
       stop facing them (publishes the name on /face_check/found) -->
  <node name="face_check" pkg="bringup" type="face_check.py" output="screen">
    <param name="person" value="$(arg person)"/>
    <param name="turn_speed" value="0.3"/>
    <param name="search_on_start" value="$(arg search_on_start)"/>
  </node>
</launch>
