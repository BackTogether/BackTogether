#!/usr/bin/env bash
# Patrol, find the child, hover over them (drone/find_child.py). Needs drone/fly running.
# Usage: drone/find <photos folder | name in drone/identify/people> [--alt 2] [--tilt -40]
#        drone/find <name> --watch     # no flight: recognise and track on the live video only
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --offline --with opencv-contrib-python-headless python -m drone.find_child "$@"
