#!/usr/bin/env bash
# L test of the drone's position estimate, no face recognition (drone/l_test.py). Needs
# drone/fly running and the drone flying. Then drone/robot <leg> <leg> for the robot's side.
# Usage: drone/ltest 2.22     # both legs of the taped L, metres
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --offline python -m drone.l_test "$@"
