#!/usr/bin/env bash
# Wait for the parent to hang up (or low battery, or the mission flying home), then land on the
# robot's pad (drone/dock_robot.py). Needs drone/fly running and the pad model.
# Usage: drone/dock --care http://<robot>:8000 [--battery 35] [--robot X Y]
#        drone/dock --now     # land on the robot right away
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --offline --with opencv-contrib-python-headless python -m drone.dock_robot "$@"
