#!/usr/bin/env bash
# Start the drone web app with Bluetooth and open it in the browser.
# Usage: drone/fly [max stick speed 0-100, default 60] [video quality sd|hd, default sd]
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p recordings
exec uv run --with bleak python -m drone.hoverctl web \
    --http-port 8077 --max "${1:-60}" --video-quality "${2:-sd}" \
    --stick-log "recordings/sticks-$(date +%H%M).jsonl"
