#!/usr/bin/env bash
# Start the drone web app with Bluetooth; open http://127.0.0.1:8077/ in one browser tab.
# No auto-open: macOS can hand the URL to a hidden headless Chrome, which then counts as
# an extra tab and posts neutral sticks.
# Usage: drone/fly [max stick speed 0-100, default 60] [video quality sd|hd, default sd] [more
# options of `python -m drone.sdk serve`, e.g. --bind 0.0.0.0 so the robot reaches the API]
# It serves the hoverctl web page plus the SDK's HTTP API (drone/sdk/API.md) and compass.
# Plain web page without the SDK: uv run --with bleak python -m drone.hoverctl web ...
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p recordings
export DRONE_MEDIA_DIR="${DRONE_MEDIA_DIR:-$HOME/Downloads}"  # PHOTO / REC from the page land here
exec uv run --offline --with bleak --with numpy python -m drone.sdk serve \
    --http-port 8077 --no-browser --max "${1:-60}" --video-quality "${2:-sd}" \
    --stick-log "recordings/sticks-$(date +%H%M).jsonl" \
    "${@:3}"
